    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@storybook/react-vite": "10.6.6",
    "@types/node": "^22.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "storybook": "10.6.6",
    "typescript": "5.9.3",
    "vite": "8.3.6"
  },
  "license": "MIT"
}
